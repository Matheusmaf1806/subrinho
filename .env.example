# Banco de dados (PostgreSQL 14+)
DATABASE_URL=postgres://subrinho:subrinho@localhost:5432/subrinho

# URL pública da aplicação (usada em links de carrinho compartilhado)
APP_URL=http://localhost:3000

# Segredo usado pelo agendador para chamar /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=troque-este-segredo
# Opcional: chave dos endereços cifrados das fotos de fornecedor (/m/...). Sem ela, deriva do CRON_SECRET.
# MEDIA_SECRET=

# Câmbio: "manual" (usa a última cotação gravada no Painel Subrinho) ou "awesomeapi"
# Para o "Dólar Poolvo", ajuste poolvoProvider em src/server/fx/index.ts e use FX_PROVIDER=poolvo
FX_PROVIDER=manual
# Idade máxima da cotação antes de buscar uma nova na API (minutos)
FX_MAX_AGE_MINUTES=30
FX_POOLVO_URL=
FX_POOLVO_TOKEN=

# Pagamentos: "mock" (simulado, para desenvolvimento). Gateway real a definir.
PAYMENT_PROVIDER=mock
PIX_KEY=financeiro@subrinho.com.br
PIX_MERCHANT_NAME=SUBRINHO
PIX_MERCHANT_CITY=SAO PAULO

# ───────── Fornecedores ─────────
# Fornecedor com credenciais preenchidas → API REAL; sem credenciais → catálogo simulado.
# Numa categoria com API real, os simulados saem da vitrine (nunca mistura hotel fictício com real).
# SUPPLIERS_MODE=mock força o simulado em tudo (desenvolvimento/testes). Em produção, deixe vazio.
SUPPLIERS_MODE=mock

# Emissão das reservas nos fornecedores reais:
#   manual (padrão) → pago, o item fica "Aguardando emissão" e a equipe emite no Painel Subrinho;
#   auto            → emite sozinho após o pagamento, SÓ com gateway de pagamento real
#                     (com PAYMENT_PROVIDER=mock nunca há emissão automática).
SUPPLIER_BOOKING=manual

# GGT | Best Buy Hotels (plataforma GoGlobal) — XML/SOAP
GGT_API_BASE_URL=https://SUA-AGENCIA.apiservice.bestbuytravel.com.br/xmlwebservice.asmx
GGT_AGENCY_ID=
GGT_USER=
GGT_PASSWORD=
GGT_ENVIRONMENT=production
# Opcionais: nacionalidade dos hóspedes (ISO) e idioma das descrições (pt = português)
# GGT_NATIONALITY=BR
# GGT_LANGUAGE=pt

# Hotelbeds (APItude) — Booking API com mTLS + Content API
# API key e secret do portal developer.hotelbeds.com (também aceita API_KEY_HH / SECRET_KEY_HH)
HB_HOTEIS_API_KEY=
HB_HOTEIS_SECRET=
# Certificado do cliente, chave privada e cadeia da CA (PEM; pode colar com quebras de linha,
# com \n literais ou em base64)
HB_HOTEIS_CLIENT_CRT=
HB_HOTEIS_CLIENT_KEY=
HB_HOTEIS_CA_CHAIN=
# production (padrão) ou test — precisa ser o ambiente das credenciais/certificado.
# As credenciais da Subrinho são de PRODUÇÃO: deixe production.
HOTELBEDS_ENVIRONMENT=production
# Opcionais: mercado de origem dos clientes (preços válidos para este país) e idioma do conteúdo
# HOTELBEDS_SOURCE_MARKET=BR
# HOTELBEDS_LANGUAGE=POR

# Demais fornecedores (integração ainda simulada)
TU_EXPERIENZA_API_KEY=
NADIO_API_KEY=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
MASTER_VACATION_HOME_API_KEY=

# MAPRO (casas de temporada) — Channels API, https://developers.mapro.io
# Token do canal + administradora, vinculado pela equipe de onboarding da MAPRO.
# NUNCA use o token DEMO em produção (as casas dele são fictícias; em produção ele é bloqueado).
MAPRO_API_TOKEN=
# Opcionais: URL da API e a política de cancelamento grátis (dias antes do check-in).
# A API não informa a política: sem MAPRO_FREE_CANCEL_DAYS a casa aparece como "Não reembolsável".
# MAPRO_API_URL=https://api.mapro.io
# MAPRO_FREE_CANCEL_DAYS=30
INTERMAC_API_KEY=
HERO_API_KEY=
ESIMX_API_KEY=
