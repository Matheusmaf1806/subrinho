# Banco de dados (PostgreSQL 14+)
DATABASE_URL=postgres://subrinho:subrinho@localhost:5432/subrinho

# URL pública da aplicação (usada em links de carrinho compartilhado)
APP_URL=http://localhost:3000

# Segredo usado pelo agendador para chamar /api/cron/* (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=troque-este-segredo

# Câmbio: "manual" (usa a última cotação gravada no Painel Subrinho) ou "awesomeapi"
# Para o "Dólar Poolvo", ajuste poolvoProvider em src/server/fx/index.ts e use FX_PROVIDER=poolvo
FX_PROVIDER=manual
# Idade máxima da cotação antes de buscar uma nova na API (minutos)
FX_MAX_AGE_MINUTES=30
FX_POOLVO_URL=
FX_POOLVO_TOKEN=

# Pagamentos: "mock" (simulado, para desenvolvimento). Gateway real a definir.
PAYMENT_PROVIDER=mock
PIX_KEY=financeiro@subrinho.com.br
PIX_MERCHANT_NAME=SUBRINHO
PIX_MERCHANT_CITY=SAO PAULO

# Fornecedores: "mock" usa catálogo simulado. Preencha as credenciais quando os contratos de API estiverem disponíveis.
SUPPLIERS_MODE=mock
TU_EXPERIENZA_API_KEY=
NADIO_API_KEY=
GGT_API_KEY=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
MASTER_VACATION_HOME_API_KEY=
MAPRO_API_KEY=
INTERMAC_API_KEY=
HERO_API_KEY=
ESIMX_API_KEY=
